rules_version = '2';

/* قواعد وسيط المزامنة.

   الحمايةُ هنا لا في apiKey: ذاك مُعرِّفٌ يُشحن في كلّ نسخةٍ من
   التطبيق ويراه كلُّ أحد، وهذه هي البوّابة.

   ولا حسابَ ولا تسجيلَ دخول: المتعلّم يُنشئ رمزاً عشوائياً من اثني
   عشر محرفاً على جهازٍ ويكتبه على الآخر مرّةً واحدة. فالرمزُ هو
   المفتاح، ومن علمه قرأ وكتب — ولذلك يُقال لصاحبه صراحةً في الشاشة
   إنّه ككلمة السرّ.

   وثلاثةُ قيودٍ تمنع ما يمنعه غيابُ الحساب:

   ١) get لا read. والفرقُ جوهريّ: read تبيح list أيضاً، فيُعدَّد
      المجموعةُ كلُّها ويُقرأ تقدّمُ الناس بلا معرفة رمز. وget تُلزم
      السائلَ أن يعرف الرمز كاملاً مقدّماً.

   ٢) طولُ الرمز اثنا عشر بالضبط. فلا تُكتب وثائقُ برموزٍ قصيرةٍ
      تُخمَّن، ولا يُتّخذ المشروع مخزناً عامّاً.

   ٣) شكلُ الوثيقة وحجمُها محدودان: ثلاثةُ حقولٍ لا رابع، والحمولةُ
      نصٌّ دون ٢٠٠ ألف محرف. فلا يُملأ المشروع ببياناتٍ غريبة.

   وما عدا هذا المسار ممنوعٌ كلُّه: الأصل المنع، والإذن استثناءٌ
   مكتوب. */
service cloud.firestore {
  match /databases/{database}/documents {

    match /sync/{code} {
      function wellFormed() {
        return code.size() == 12
          && request.resource.data.keys().hasOnly(['v', 'at', 'data'])
          && request.resource.data.v is int
          && request.resource.data.at is int
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0
          && request.resource.data.data.size() < 200000;
      }

      allow get: if code.size() == 12;
      allow create, update: if wellFormed();

      /* التعداد ممنوع، والحذف ممنوع: المزامنة تكتب فوق، ولا تمحو —
         فلا يستطيع من عرف الرمز أن يُفني تقدّم صاحبه بضغطةٍ واحدة. */
      allow list, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
